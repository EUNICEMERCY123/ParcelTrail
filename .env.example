# ParcelTrail Environment Variables Reference
# Copy server/.env.example -> server/.env (required for backend)
# Copy client/.env.example -> client/.env (optional for custom frontend API base URL)

# ---- Backend (server/.env) ----
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/parcelTrail?retryWrites=true&w=majority
MONGODB_TEST_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/parceltrail_test?retryWrites=true&w=majority
PORT=5000
CORS_ORIGIN=http://localhost:3000,https://parcel-trail.vercel.app

# ---- Frontend (client/.env) ----
VITE_API_BASE_URL=/api
VITE_PROXY_TARGET=http://localhost:5000
